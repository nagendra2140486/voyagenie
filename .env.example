# ---------------------------------------------------------------------------
# Voyagenie - shared configuration example.
# Copy to .env and adjust. Never commit real API keys.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
DATABASE_URL=postgresql://voyagenie:voyagenie@localhost:5432/voyagenie

# --- Application backend (Node/Express) ------------------------------------
BACKEND_PORT=4000
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
PUBLIC_ORIGIN=http://localhost:5173
CONTACT_INQUIRIES_PER_HOUR=5
# Swagger UI and the OpenAPI spec. Defaults to off when NODE_ENV=production.
API_DOCS_ENABLED=true

# --- Python AI service ------------------------------------------------------
AI_SERVICE_PORT=8000

# --- LLM provider (provider-agnostic adapter) -------------------------------
# mock   -> deterministic offline adapter, no key needed (default)
# openai -> OpenAI / Codex compatible chat completions
# claude -> Anthropic messages API
LLM_PROVIDER=mock
LLM_MODEL=mock-travel-1
LLM_API_KEY=
# Optional override for OpenAI-compatible gateways (Azure, Codex proxy, ...)
LLM_BASE_URL=

# --- Guardrails -------------------------------------------------------------
LLM_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_CHARS=2000
LLM_MAX_OUTPUT_TOKENS_ITINERARY=1000
LLM_MAX_OUTPUT_TOKENS_CHAT=500
LLM_MAX_OUTPUT_TOKENS_BUDGET=700
RATE_LIMIT_ITINERARY_PER_HOUR=10
RATE_LIMIT_CHAT_PER_HOUR=25
RATE_LIMIT_BUDGET_PER_HOUR=10
LLM_CACHE_ENABLED=true

# --- Frontend (Vite) --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
